#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define OPT  1
#define SYM  2
#define NAV  3
#define SYS  4
#define NUM  5
#define WM   6

&sk {
    release-after-ms = <1000>;
    quick-release;
};

/ {
    macros {
        m_wh: m_wh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp W &kp H>;
        };
        m_th: m_th {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp T &kp H>;
        };
        m_ch: m_ch {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp C &kp H>;
        };
        m_sh: m_sh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp S &kp H>;
        };
        m_ph: m_ph {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp P &kp H>;
        };
        m_gh: m_gh {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp G &kp H>;
        };
        m_qu: m_qu {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp Q &kp U>;
        };
        m_lg: m_lg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp BSPC &kp L &kp G>;
        };
        m_mp: m_mp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp BSPC &kp M &kp P>;
        };
        m_wd: m_wd {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp BSPC &kp W &kp D>;
        };
        m_pg: m_pg {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp BSPC &kp P &kp G>;
        };
        m_iw: m_iw {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp BSPC &kp I &kp W>;
        };
        m_sp: m_sp {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_tap &kp BSPC &kp S &kp P>;
        };
    };

    combos {
        compatible = "zmk,combos";
        combo_z {
            timeout-ms = <45>;
            layers = <BASE>;
            key-positions = <2 3>;
            bindings = <&kp Z>;
        };
        combo_q {
            timeout-ms = <45>;
            layers = <BASE>;
            key-positions = <3 4>;
            bindings = <&kp Q>;
        };
        combo_qu {
            timeout-ms = <45>;
            layers = <BASE>;
            key-positions = <2 4>;
            bindings = <&m_qu>;
        };
        // OPT layer: same finger pattern as BASE, mirrored onto the right bottom row
        // (C index, M middle, W ring); these letter pairs are under 0.01% of English bigrams
        combo_z_opt {
            timeout-ms = <45>;
            layers = <OPT>;
            key-positions = <32 33>; // M + W
            bindings = <&kp Z>;
        };
        combo_q_opt {
            timeout-ms = <45>;
            layers = <OPT>;
            key-positions = <31 32>; // C + M
            bindings = <&kp Q>;
        };
        combo_qu_opt {
            timeout-ms = <45>;
            layers = <OPT>;
            key-positions = <31 33>; // C + W
            bindings = <&m_qu>;
        };
    };

    behaviors {
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };

        ad_m: adaptive_m {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_M";
            #binding-cells = <0>;
            defaults = <&kp M>;
            bindings = <&kp L>, <&kp L>;
            antecedents = <G P>;
            max-delay-ms = <200>;
        };

        ad_g: adaptive_g {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_G";
            #binding-cells = <0>;
            defaults = <&kp G>;
            bindings = <&m_lg>, <&m_pg>;
            antecedents = <M W>;
            max-delay-ms = <200>;
        };

        ad_ha: adaptive_ha {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_H";
            #binding-cells = <0>;
            defaults = <&kp H>;
            bindings = <&kp U>, <&kp U>;
            antecedents = <A>;
            max-delay-ms = <200>;
        };

        ad_a: adaptive_a {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_A";
            #binding-cells = <0>;
            defaults = <&kp A>;
            bindings = <&kp U>, <&kp U>;
            antecedents = <H>;
            max-delay-ms = <200>;
        };

        ad_f: adaptive_f {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_F";
            #binding-cells = <0>;
            defaults = <&kp F>;
            bindings = <&kp G>, <&kp S>;
            antecedents = <D B>;
            max-delay-ms = <200>;
        };

        ad_p: adaptive_p {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_P";
            #binding-cells = <0>;
            defaults = <&kp P>;
            bindings = <&m_sp>;
            antecedents = <F>;
            max-delay-ms = <200>;
        };

        ad_y: adaptive_y {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_Y";
            #binding-cells = <0>;
            defaults = <&kp Y>;
            bindings = <&kp I>;
            antecedents = <W>;
            max-delay-ms = <200>;
        };

        ad_w: adaptive_w {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_W";
            #binding-cells = <0>;
            defaults = <&kp W>;
            bindings = <&m_iw>;
            antecedents = <Y>;
            max-delay-ms = <200>;
        };

        ad_d: adaptive_d {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_D";
            #binding-cells = <0>;
            defaults = <&kp D>;
            bindings = <&m_wd>;
            antecedents = <F>;
            max-delay-ms = <200>;
        };

        ad_fslh: adaptive_fslh {
            compatible = "zmk,behavior-antecedent-morph";
            label = "ADAPTIVE_FSLH";
            #binding-cells = <0>;
            defaults = <&kp FSLH>;
            bindings = <&kp U>;
            antecedents = <A>;
            max-delay-ms = <200>;
        };

        // OPT layer adaptives: the four that remove the most same-finger load (sc, wn, bl, ui)
        ad_opt_d: adaptive_opt_d {
            compatible = "zmk,behavior-antecedent-morph";
            #binding-cells = <0>;
            defaults = <&kp D>;
            bindings = <&kp C>;       // S then D types "sc"
            antecedents = <S>;
            max-delay-ms = <200>;
        };

        ad_opt_k: adaptive_opt_k {
            compatible = "zmk,behavior-antecedent-morph";
            #binding-cells = <0>;
            defaults = <&kp K>;
            bindings = <&kp N>;       // W then K types "wn"
            antecedents = <W>;
            max-delay-ms = <200>;
        };

        ad_opt_h: adaptive_opt_h {
            compatible = "zmk,behavior-antecedent-morph";
            #binding-cells = <0>;
            defaults = <&kp H>;
            bindings = <&kp L>, <&kp I>, <&kp M>;   // B,H -> "bl"   U,H -> "ui"   L,H -> "lm"
            antecedents = <B U L>;
            max-delay-ms = <200>;
        };

        ad_opt_minus: adaptive_opt_minus {
            compatible = "zmk,behavior-antecedent-morph";
            #binding-cells = <0>;
            defaults = <&kp MINUS>;
            bindings = <&kp E>;       // E then - types "ee" (no double-tap on the thumb)
            antecedents = <E>;
            max-delay-ms = <200>;     // a little longer: thumb-to-index rolls start from a layer-tap
        };

        ad_opt_equal: adaptive_opt_equal {
            compatible = "zmk,behavior-antecedent-morph";
            #binding-cells = <0>;
            defaults = <&kp EQUAL>;
            bindings = <&kp K>;       // O then = types "ok" (no ring/middle scissor)
            antecedents = <O>;
            max-delay-ms = <200>;
        };

        // home-row mod whose tap is the adaptive H (used as &hm_opt_h LCTRL 0)
        hm_opt_h: homerow_mod_opt_h {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&ad_opt_h>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        // Layer 0: Default
        // ╭─────────────────────────────────────────────╮ ╭─────────────────────────────────────────────╮
        // │  TAB  │   V   │   W   │  ad_g │  ad_m │   J  │ │  SEMI │   .   │   '   │  FSLH │   =   │  BSPC │
        // │ ESC/4 │ S/GUI │ N/CTL │ T/SFT │ H/ALT │   K  │ │  ,    │ A/ALT │ E/SFT │ I/CTL │ C/GUI │  BSLH │
        // │ LSHFT │  ad_p │  ad_f │  ad_d │   L   │   X  │ │  -    │   U   │   O   │  ad_y │   B   │ RSHFT │
        // ╰───────────────────╮  lt2 R │  mo4  │ BSPC  │ │ SPACE │ sk LSFT│ ENTER ╭───────────────────╯
        //                     ╰────────────────────────╯ ╰───────────────────────╯

        default_layer {
            bindings = <
   &kp TAB     &kp V          &ad_w        &ad_g         &ad_m       &kp J         &kp SEMICOLON  &kp PERIOD  &kp APOS      &ad_fslh     &kp EQUAL   &mo SYS
   &lt NUM ESC &hm LGUI S     &hm LCTRL N  &hm LSHIFT T  &hm LALT H  &kp K         &kp COMMA      &hm LALT A  &hm LSHIFT E  &hm LCTRL I  &hm LGUI C  &kp ENTER
   &kp LSHFT   &ad_p          &ad_f        &ad_d         &kp L       &kp X         &kp MINUS      &kp U       &kp O         &ad_y        &kp B       &mo WM
                                           &kp BSPC      &lt NAV R   &sk LSHFT     &sk LSHFT      &lt SYM SPACE &kp ENTER
            >;
        };

        // Layer 1: OPT (alternate base, &to OPT from the system layer)
        // Analyzer optimum (tools/layout-analyzer): E on the thumb, vowels on the left hand.
        // Combos on this layer: Z = M+W, Q = C+M, QU = C+W (right bottom row).
        // Adaptives: S,D -> sc   W,K -> wn   B,H -> bl   U,H -> ui   L,H -> lm   E,- -> ee   O,= -> ok
        // ╭───────────────────────────────────────╮ ╭───────────────────────────────────────╮
        // │       │  J  │  P  │  O  │  U  │  -  │ │  F  │  G  │  D  │  L  │  =  │       │
        // │       │ Y/G │ H/C │ A/S │ I/A │  .  │ │  B  │ S/A │ T/S │ N/C │ R/G │       │
        // │       │  /  │  K  │  '  │  ,  │  ;  │ │  V  │  C  │  M  │  W  │  X  │       │
        // ╰───────────────────╮   BSPC   │ E/NAV │ SHFT │ │ SHFT │ SPC/SYM │ ENT ╭───────────────────╯
        opt_layer {
            bindings = <
   &trans  &kp J          &kp P          &kp O           &kp U          &ad_opt_minus &kp F       &kp G          &ad_opt_d       &kp L          &ad_opt_equal &trans
   &trans  &hm LGUI Y     &hm_opt_h LCTRL 0 &hm LSHIFT A    &hm LALT I     &kp PERIOD    &kp B       &hm LALT S     &hm LSHIFT T    &hm LCTRL N    &hm LGUI R    &trans
   &trans  &kp FSLH       &ad_opt_k      &kp APOS        &kp COMMA      &kp SEMI      &kp V       &kp C          &kp M           &kp W          &kp X         &trans
                                         &trans          &lt NAV E      &trans        &trans      &trans         &trans
            >;
        };

        // Layer 2: Symbols (right thumb space hold)
        // Mirrors your layer_keypad symbols
        layer_sym {
            bindings = <
   &none   &kp EXCL   &kp AT     &kp HASH   &kp DLLR   &kp PRCNT      &kp CARET  &kp AMPS   &kp STAR   &none      &none      &none
   &none   &kp QMARK  &kp TILDE  &kp LBRC   &kp LPAR   &kp LBKT       &kp BSLH   &kp COLON  &kp MINUS  &kp EQUAL  &none      &none
   &none   &none      &kp GRAVE  &kp RBRC   &kp RPAR   &kp RBKT       &none      &kp PIPE   &kp PLUS   &kp UNDER  &none      &none
                                 &trans      &trans     &trans         &trans     &trans     &trans
            >;
        };

        // Layer 3: Nav (left thumb hold)
        // Arrow keys, page nav — mirrors layer_fn
        layer_nav {
            bindings = <
   &none   &none   &kp TAB   &none      &none    &none        &none      &kp PG_DN  &kp PG_UP  &none      &none   &none
   &none   &none   &kp ESC   &none      &none    &none        &kp LEFT   &kp DOWN   &kp UP     &kp RIGHT  &none   &none
   &none   &none   &none     &kp DOWN   &kp UP   &none        &none      &kp BSPC   &none      &kp ENTER  &none   &none
                             &trans     &trans   &trans       &trans     &trans     &trans
            >;
        };

        // Layer 4: Bluetooth / System (top-right outer key); bottom row right: &to BASE / &to OPT
        layer_bt {
            bindings = <
   &none   &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4      &none   &none   &none   &none   &none   &none
   &none   &none         &none         &none         &none         &none             &none   &none   &none   &none   &none   &none
   &none   &none         &none         &none         &none         &bt BT_CLR        &none   &to BASE &to OPT &none   &none   &none
                                       &none         &none         &none             &none   &none   &none
            >;
        };

        // Layer 5: Numpad (ESC hold)
        // Mirrors layer_num
        layer_num {
            bindings = <
   &none   &none   &none   &none     &none      &none        &none       &kp N7  &kp N8  &kp N9  &none   &none
   &none   &none   &none   &kp LSHFT &kp LALT   &none        &kp PERIOD  &kp N4  &kp N5  &kp N6  &none   &none
   &none   &none   &none   &none     &none      &none        &none       &kp N1  &kp N2  &kp N3  &none   &none
                           &trans    &trans     &trans       &kp N0      &kp N0  &trans
            >;
        };

        // Layer 6: Window manager
        layer_wm {
            bindings = <
   &none  &none  &none  &none  &none  &none      &none  &none  &none  &none  &none  &none
   &none  &kp LA(N1)  &kp LA(N2)  &kp LA(N3)  &kp LA(N4)  &kp LA(N5)      &kp LA(N6)  &kp LA(N7)  &kp LA(N8)  &kp LA(N9)  &none  &none
   &none  &kp LA(LS(N1))  &kp LA(LS(N2))  &kp LA(LS(N3))  &kp LA(LS(N4))  &kp LA(LS(N5))      &kp LA(LS(N6))  &kp LA(LS(N7))  &kp LA(LS(N8))  &kp LA(LS(N9))  &none  &none
                  &trans  &trans  &trans      &trans  &trans  &trans
            >;
        };
    };
};
